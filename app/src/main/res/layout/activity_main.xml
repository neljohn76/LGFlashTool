<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="14dp">
        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="@string/app_name" android:src="@drawable/lgflash_master" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/toolbar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LGFlashTool" android:textColor="@color/text_main" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Native firmware utility" android:textColor="@color/text_sub" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/status_pill" android:paddingHorizontal="10dp" android:paddingVertical="6dp" android:text="v0.1.0" android:textColor="@color/accent_cyan" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TARGET DEVICE" android:textColor="@color/accent_cyan" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvDeviceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/no_device" android:textColor="@color/text_main" android:textSize="14sp" />
        <Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/connect" android:textAllCaps="false" />
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout android:id="@+id/workflowTabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:contentDescription="@string/workflow_tabs" app:tabIndicatorColor="@color/accent_cyan" app:tabSelectedTextColor="@color/accent_cyan" app:tabTextColor="@color/text_sub" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/cardLaf" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DOWNLOAD MODE / LAF" android:textColor="@color/accent_cyan" android:textSize="11sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnPickLafFirmware" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/pick_firmware" android:textAllCaps="false" />
                    <TextView android:id="@+id/tvLafFirmwareInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/firmware_none" android:textColor="@color/text_sub" android:textSize="13sp" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/listItems" android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="8dp" />
                    <CheckBox android:id="@+id/chkAllowLowBlocks" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="@color/accent_amber" android:text="@string/allow_low_blocks" android:textColor="@color/text_sub" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAF FLASH CONTROL" android:textColor="@color/accent_cyan" android:textSize="11sp" android:textStyle="bold" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:max="1000" app:trackColor="@color/progress_track" app:indicatorColor="@color/accent_cyan" />
                    <TextView android:id="@+id/tvProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_sub" android:textSize="12sp" />
                    <CheckBox android:id="@+id/chkAutoReboot" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/auto_reboot" android:textColor="@color/text_sub" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <Button android:id="@+id/btnFlash" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:backgroundTint="@color/accent_cyan" android:text="@string/flash" android:textAllCaps="false" android:textColor="@color/on_accent" />
                        <Button android:id="@+id/btnReboot" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/reboot" android:textAllCaps="false" android:textSize="11sp" />
                        <Button android:id="@+id/btnPowerOff" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/power_off" android:textAllCaps="false" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardEdl" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EDL / QFIL WORKSPACE" android:textColor="@color/accent_cyan" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Upload a device-matched firehose programmer, then perform one explicit partition operation at a time." android:textColor="@color/text_sub" android:textSize="12sp" />
                    <Button android:id="@+id/btnPickProgrammer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/pick_programmer" android:textAllCaps="false" />
                    <TextView android:id="@+id/tvProgrammer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/programmer_none" android:textColor="@color/text_sub" android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PARTITION IMAGE OPERATION" android:textColor="@color/accent_cyan" android:textSize="11sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnPickEdlImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/pick_edl_image" android:textAllCaps="false" />
                    <TextView android:id="@+id/tvEdlImageInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/firmware_none" android:textColor="@color/text_sub" android:textSize="13sp" />
                    <EditText android:id="@+id/editPartitionName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/edl_partition_hint" android:inputType="text" android:textSize="13sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <EditText android:id="@+id/editLun" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/edl_lun_hint" android:inputType="number" android:text="0" android:textSize="13sp" />
                        <EditText android:id="@+id/editStartSector" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:hint="@string/edl_start_hint" android:inputType="number" android:text="0" android:textSize="13sp" />
                    </LinearLayout>
                    <Button android:id="@+id/btnFlashEdl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/accent_cyan" android:text="@string/flash_partition" android:textAllCaps="false" android:textColor="@color/on_accent" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EDL FACTORY RESET" android:textColor="@color/accent_amber" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Erases the user-data range through Firehose. Geometry is never guessed; enter the verified userdata start sector and sector count for this device." android:textColor="@color/text_sub" android:textSize="12sp" />
                    <EditText android:id="@+id/editEraseSectors" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/edl_erase_count_hint" android:inputType="number" android:textSize="13sp" />
                    <Button android:id="@+id/btnFactoryReset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/accent_amber" android:text="@string/factory_reset_edl" android:textAllCaps="false" android:textColor="@color/on_accent" />
                </LinearLayout>
            </LinearLayout>
            <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="14dp" android:background="@drawable/console_bg">
                <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:padding="16dp" android:textColor="@color/console_text" android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
