<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="⚡ LG Flash Tool"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Device / connection card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvDeviceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_device"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/connect" />
            </LinearLayout>

            <!-- Mode selection -->
            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioLaf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/laf_mode"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/radioEdl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/edl_mode"
                    android:textColor="@color/text_main"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- Firmware selection -->
            <Button
                android:id="@+id/btnPickFirmware"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pick_firmware" />

            <TextView
                android:id="@+id/tvFirmwareInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/firmware_none"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listItems"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="4dp" />

            <CheckBox
                android:id="@+id/chkAllowLowBlocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allow_low_blocks"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <!-- EDL options -->
            <LinearLayout
                android:id="@+id/cardEdl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnPickProgrammer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_programmer" />

                <TextView
                    android:id="@+id/tvProgrammer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/programmer_none"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editLun"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/edl_lun_hint"
                        android:inputType="number"
                        android:text="0"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/editStartSector"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="@string/edl_start_hint"
                        android:inputType="number"
                        android:text="0"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Progress -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="1000" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/chkAutoReboot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/auto_reboot"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFlash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:backgroundTint="@color/button_flash"
                    android:text="@string/flash"
                    android:textColor="@color/text_main" />

                <Button
                    android:id="@+id/btnReboot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/reboot"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnPowerOff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/power_off"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Log -->
            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="@color/text_sub"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
